    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "result = []\ncontract = _items[0][\"json\"].get(\"output\", {})\n\n# Case 1: output là dict\nif isinstance(contract, dict):\n    for key, value in contract.items():\n        result.append({\"json\": {\"key\": key, \"value\": value}})\n    return result\n\n# Case 2: output là string JSON phẳng {\"a\":\"\", \"b\":\"\", ...}\nif isinstance(contract, str):\n    s = contract.strip()\n\n    # bỏ { } nếu có\n    if len(s) >= 2 and s[0] == \"{\" and s[-1] == \"}\":\n        s = s[1:-1].strip()\n\n    if s:\n        parts = s.split(\",\")\n        for part in parts:\n            if \":\" not in part:\n                continue\n            k, v = part.split(\":\", 1)\n            k = k.strip().strip('\"')\n            v = v.strip()\n\n            # bỏ quote value nếu là string\n            if len(v) >= 2 and v[0] == '\"' and v[-1] == '\"':\n                v = v[1:-1]\n\n            # unescape tối thiểu\n            v = v.replace('\\\\\"', '\"').replace('\\\\\\\\', '\\\\')\n\n            result.append({\"json\": {\"key\": k, \"value\": v}})\n\n    return result\n\n# Case khác thì trả rỗng\nreturn result\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
